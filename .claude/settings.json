{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "model": "sonnet",
  "effortLevel": "medium",
  "permissions": {
    "allow": [
      "Read",
      "Edit",
      "Bash(uv run *)",
      "Bash(uv sync *)",
      "Bash(uv build *)",
      "Bash(git status)",
      "Bash(git fetch *)",
      "Bash(git log *)",
      "Bash(git diff *)",
      "Bash(git show *)",
      "Bash(git rev-parse *)",
      "Bash(git branch --show-current)",
      "Bash(git branch -a)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(ls *)",
      "Bash(cat *)",
      "Bash(find *)",
      "Bash(grep *)",
      "Bash(head *)",
      "Bash(tail *)",
      "Bash(wc *)",
      "Bash(pwd)",
      "Bash(tree *)",
      "Bash(file *)",
      "Bash(which *)",
      "Bash(mkdir *)",
      "Bash(touch *)",
      "Bash(cp *)",
      "Bash(mv *)",
      "Bash(echo *)",
      "Bash(gh auth status)",
      "Bash(gh issue view *)",
      "Bash(gh pr view *)",
      "Bash(gh pr list *)",
      "Bash(gh issue list *)",
      "Bash(git push *)",
      "Bash(gh pr create *)",
      "Bash(git checkout *)",
      "Bash(git worktree *)",
      "Bash(opencode run *)"
    ],
    "ask": [
      "Bash(git remote *)",
      "Bash(gh pr merge *)",
      "Bash(gh pr close *)",
      "Bash(gh issue create *)",
      "Bash(gh issue close *)",
      "Bash(gh issue edit *)",
      "Bash(rm *)",
      "Bash(rmdir *)",
      "Bash(curl *)",
      "Bash(wget *)",
      "Bash(ssh *)",
      "Bash(scp *)",
      "Bash(rsync *)",
      "Bash(git reset *)",
      "Bash(git rebase *)",
      "Bash(git clean *)",
      "Bash(git stash *)",
      "Bash(git branch -d *)",
      "Bash(git branch -D *)"
    ],
    "deny": [
      "Bash(gh repo *)",
      "Bash(chmod *)",
      "Bash(chown *)",
      "Bash(sudo *)",
      "Bash(opencode run *--auto*)"
    ]
  }
}
